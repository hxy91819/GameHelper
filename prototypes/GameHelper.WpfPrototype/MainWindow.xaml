<Window x:Class="GameHelper.WpfPrototype.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GameHelper · WPF 体验原型" Width="1280" Height="840" MinWidth="1040" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#10141D" Foreground="#EEF2F8" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <ItemsPanelTemplate x:Key="CardsPanel"><WrapPanel /></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="RowsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
  <DataTemplate x:Key="CardTemplate">
   <Grid Width="210" Margin="5">
    <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{Binding Artwork}" CornerRadius="9">
     <Grid ClipToBounds="True">
      <Ellipse Width="140" Height="140" Stroke="#25FFFFFF" StrokeThickness="24" HorizontalAlignment="Right" Margin="0,-45,-35,0" />
      <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="Light" Margin="18" VerticalAlignment="Bottom" />
      <TextBlock Text="封面占位" FontSize="10" Foreground="#B8FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Margin="2,12,2,8">
     <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
     <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="RowTemplate">
   <Grid Height="68" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
    <Border Background="{Binding Artwork}" CornerRadius="8" Height="44" Width="44"><TextBlock Text="{Binding Initial}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
    </StackPanel>
   </Grid>
  </DataTemplate>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Padding" Value="0" />
   <Setter Property="Margin" Value="0,0,0,3" />
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="ItemBorder" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="Transparent"><ContentPresenter /></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1B2434" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#688EFF" /><Setter TargetName="ItemBorder" Property="Background" Value="#202C43" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BCD1FF" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#141A25" BorderBrush="#253044" BorderThickness="0,0,1,0">
   <Grid Margin="20,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="GH /" FontSize="31" FontWeight="Bold" Foreground="#8DAEFF" /><TextBlock Text="GameHelper" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="YOUR LOCAL LIBRARY" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,43,0,0">
     <Border Background="#283755" CornerRadius="8" Padding="14,12"><TextBlock Text="▦   游戏库" Foreground="#C8D8FF" FontWeight="SemiBold" /></Border>
     <TextBlock Text="发现与导入" Margin="14,23,0,6" Foreground="{StaticResource Muted}" />
     <TextBlock Text="已有 Steam 导入能力" FontSize="10" Margin="14,0,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="3"><TextBlock Text="WPF / 体验原型" FontSize="12" Foreground="#A6BEFF" /><TextBlock Text="只读载入 · 修改不保存" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,26,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="游戏库" FontSize="30" FontWeight="SemiBold" /><TextBlock x:Name="CatalogSummary" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
    <Border Grid.Column="1" VerticalAlignment="Center" Background="#1C2432" CornerRadius="8" Padding="13,10" BorderBrush="#354156" BorderThickness="1">
     <Grid><TextBox x:Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White" TextChanged="OnSearchChanged" ToolTip="搜索游戏名称或文件名（Ctrl+F）" AutomationProperties.Name="搜索游戏" /><TextBlock x:Name="SearchHint" Text="搜索游戏                         Ctrl F" Foreground="{StaticResource Muted}" IsHitTestVisible="False" /></Grid>
    </Border>
   </Grid>
   <DockPanel Grid.Row="1" Margin="0,26,0,17">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="AllFilter" Content="全部" Tag="all" Click="OnFilter" Margin="0,0,8,0" />
     <Button x:Name="HdrFilter" Content="HDR" Tag="hdr" Click="OnFilter" Margin="0,0,8,0" />
     <Button x:Name="SpeedFilter" Content="倍速" Tag="speed" Click="OnFilter" />
    </StackPanel>
    <TextBlock x:Name="ResultCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
   </DockPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="*" /><ColumnDefinition x:Name="DetailColumn" Width="0" /></Grid.ColumnDefinitions>
    <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" Foreground="White" ClipToBounds="True" SelectionChanged="OnGameSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" />
    <TextBlock x:Name="EmptyState" Text="没有匹配的游戏。试试其他名称，或取消筛选。" TextWrapping="Wrap" Margin="20,40" Foreground="{StaticResource Muted}" Visibility="Collapsed" IsHitTestVisible="False" />
    <Border x:Name="Details" Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="12" Margin="16,0,0,0" Visibility="Collapsed">
     <ScrollViewer Foreground="#EEF2F8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22">
       <Border x:Name="Hero" Height="160" Background="{Binding Artwork}" CornerRadius="9" Margin="0,0,0,20"><Grid><Ellipse Width="170" Height="170" Stroke="#20FFFFFF" StrokeThickness="32" HorizontalAlignment="Right" /><TextBlock Text="{Binding Initial}" Foreground="#DCE7FF" FontSize="54" Margin="16" VerticalAlignment="Center" /><TextBlock Text="封面占位" Foreground="#DCE7FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" FontSize="11" /></Grid></Border>
       <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="启动偏好 · 本次预览" Foreground="{StaticResource Muted}" Margin="0,20,0,4" />
       <CheckBox x:Name="HdrCheck" Content="启动前开启 HDR" />
       <CheckBox x:Name="SpeedCheck" Content="启动后启用倍速" />
       <TextBlock x:Name="SpeedLabel" Foreground="{StaticResource Muted}" FontSize="12" />
       <Button Content="预览启动步骤  →" Background="#7599FF" Foreground="#0E1728" FontWeight="SemiBold" Margin="0,23,0,12" Click="OnPreviewLaunch" />
       <TextBlock Text="此按钮展示启动流程，不启动游戏。偏好调整仅在当前窗口中有效。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
       <Expander Header="匹配的程序" Foreground="#A8B6CC" Margin="0,24,0,0"><TextBlock Text="{Binding Executable}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8" /></Expander>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <Border x:Name="SelectionBar" Grid.Row="3" Background="#1C2638" CornerRadius="10" Padding="16,12" Margin="0,13,0,0">
    <DockPanel><Button DockPanel.Dock="Right" Content="查看启动偏好  →" Click="OnInspectSelection" /><TextBlock x:Name="SelectedName" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,15,0" /></DockPanel>
   </Border>
   <StackPanel Grid.Row="4" Margin="0,18,0,0">
    <Border Background="#202B41" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="CardsButton" Content="1  封面网格" Tag="0" Click="OnVariant" Margin="0,0,8,0" />
      <Button x:Name="RowsButton" Content="2  紧凑列表" Tag="1" Click="OnVariant" Margin="0,0,8,0" />
      <Button x:Name="FocusButton" Content="3  详情视图" Tag="2" Click="OnVariant" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,11,0,0" />
   </StackPanel>
  </Grid>
 </Grid>
</Window>
