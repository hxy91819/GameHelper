<Project Sdk="Microsoft.NET.Sdk">
  <!-- This suite executes the real Core/Infrastructure code without loading WPF on Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>GameHelper.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../GameHelper.Infrastructure/GameHelper.Infrastructure.csproj" />
    <Compile Include="../../GameHelper.Desktop/LibraryDraftStore.cs" Link="LibraryDraftStore.cs" />
    <Compile Include="../LibrarySpeedHotkeyDraftTests.cs" Link="LibrarySpeedHotkeyDraftTests.cs" />
    <Compile Include="../SpeedHotkeyTests.cs" Link="SpeedHotkeyTests.cs" />
    <Compile Include="../CheatEngineSpeedHotkeyLuaTests.cs" Link="CheatEngineSpeedHotkeyLuaTests.cs" />
    <Compile Include="../CheatEngineSpeedControllerTests.cs" Link="CheatEngineSpeedControllerTests.cs" />
    <Compile Include="../GameCatalogSpeedAttachTests.cs" Link="GameCatalogSpeedAttachTests.cs" />
    <Compile Include="../YamlConfigValidatorTests.cs" Link="YamlConfigValidatorTests.cs" />
    <Compile Include="../YamlConfigProviderTests.cs" Link="YamlConfigProviderTests.cs" />
    <Compile Include="../GameAutomationServiceTests.cs" Link="GameAutomationServiceTests.cs" />
    <Compile Include="../SpeedAttachSchedulerTests.cs" Link="SpeedAttachSchedulerTests.cs" />
  </ItemGroup>
</Project>
