<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameHelper.Core\GameHelper.Core.csproj" />
    <ProjectReference Include="..\GameHelper.Infrastructure\GameHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- A complete release contains both shells; the desktop only talks to this runtime via IPC. -->
  <Target Name="PublishDesktopLibrary" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(PublishDesktop)' != 'false'">
    <PropertyGroup>
      <DesktopSelfContained Condition="'$(SelfContained)' == ''">false</DesktopSelfContained>
      <DesktopSelfContained Condition="'$(SelfContained)' != ''">$(SelfContained)</DesktopSelfContained>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\GameHelper.Desktop\GameHelper.Desktop.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained $(DesktopSelfContained) -o &quot;$(PublishDir)desktop&quot; --nologo" />
  </Target>
</Project>
