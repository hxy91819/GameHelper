<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameHelper.Core\GameHelper.Core.csproj" />
    <ProjectReference Include="..\GameHelper.Infrastructure\GameHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="PublishPassiveLauncher" AfterTargets="Publish">
    <PropertyGroup>
      <LauncherPublishDir>$(MSBuildProjectDirectory)\obj\launcher-publish\$(Configuration)\$(RuntimeIdentifier)\</LauncherPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\GameHelper.Launcher\GameHelper.Launcher.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(LauncherPublishDir)" />
    <ItemGroup>
      <LauncherFiles Include="$(LauncherPublishDir)GameHelper.Launcher.exe;$(LauncherPublishDir)GameHelper.Launcher.dll;$(LauncherPublishDir)GameHelper.Launcher.deps.json;$(LauncherPublishDir)GameHelper.Launcher.runtimeconfig.json" />
    </ItemGroup>
    <!-- ConsoleHost owns the shared runtime. Copy only launcher-specific files into staging. -->
    <Copy SourceFiles="@(LauncherFiles)" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
