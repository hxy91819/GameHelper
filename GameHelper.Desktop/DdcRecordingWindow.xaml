<Window x:Class="GameHelper.Desktop.DdcRecordingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="录制显示器预设" Width="560" Height="520" MinHeight="440" MinWidth="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource Page}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="DDC 两步录制" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="读取第一台可控制显示器的模式差异。不会向显示器写入设置。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,20" /></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="Step" Text="1 / 2 · 舒适模式" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="Instruction" Text="先保存关闭显示器自动预设，关闭所有显示器 HDR，再用显示器实体菜单切到舒适模式，然后读取。" TextWrapping="Wrap" Margin="0,12,0,20" /><Button x:Name="Capture" Content="读取舒适模式" Click="OnCapture" HorizontalAlignment="Left" /><TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16" AutomationProperties.LiveSetting="Polite" /><Button Content="重新开始" Click="OnReset" HorizontalAlignment="Left" /></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,12,0" /><Button x:Name="Accept" Content="使用这两份配方" IsEnabled="False" Click="OnAccept" /></StackPanel>
 </Grid>
</Window>
