<Application x:Class="GameHelper.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <SolidColorBrush x:Key="Muted" Color="#9AA8BE" />
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FA" /></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101823" /><Setter Property="Foreground" Value="#EEF3FB" />
   <Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#3B4B64" />
   <Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,5,0,10" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0FA" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,9" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#25324A" /><Setter Property="Foreground" Value="#F2F5FD" />
   <Setter Property="Padding" Value="14,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B7CFFF" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#EEF3FB" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Margin="0,0,3,5"><ContentPresenter /></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#1B293D" /></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#789DFF" /><Setter TargetName="ItemChrome" Property="Background" Value="#23344F" /></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#C2D5FF" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526079" CornerRadius="4" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
