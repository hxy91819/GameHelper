<UserControl x:Class="GameHelper.Desktop.PlaytimeReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
  <StackPanel>
   <TextBlock Text="年度 / 季度报告" FontSize="18" FontWeight="SemiBold" />
   <TextBlock Text="程序统计 · 自然年与自然季度 · 仅在点击时发送汇总生成点评" Foreground="{DynamicResource Muted}" Margin="0,8,0,12" TextWrapping="Wrap" />
   <WrapPanel x:Name="Actions">
    <TextBlock Text="年份" VerticalAlignment="Center" Margin="0,0,8,8" />
    <TextBox x:Name="Year" Width="75" Margin="0,0,12,8" AutomationProperties.Name="报告年份" />
    <ComboBox x:Name="Period" Width="130" SelectedIndex="0" Margin="0,0,12,8" AutomationProperties.Name="报告期间"><ComboBoxItem Content="年度" /><ComboBoxItem Content="第一季度" /><ComboBoxItem Content="第二季度" /><ComboBoxItem Content="第三季度" /><ComboBoxItem Content="第四季度" /></ComboBox>
    <Button Content="生成报告" Click="OnGenerate" Margin="0,0,12,8" />
    <Button x:Name="CommentButton" Content="生成大模型点评" Click="OnComment" IsEnabled="False" Margin="0,0,12,8" />
    <Button x:Name="ExportButton" Content="导出 Markdown…" Click="OnExport" IsEnabled="False" Margin="0,0,0,8" />
   </WrapPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite" />
   <Expander Header="报告正文（展开查看）" x:Name="BodyPanel" Visibility="Collapsed">
    <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="游玩报告正文" />
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
