<UserControl x:Class="GameHelper.Desktop.GlobalSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,18" /><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,14" /></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource Input}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,5,0,12" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="9,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="16,0,0,0" /><ContentPresenter Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" /></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" MinWidth="150"><ItemsPresenter /></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Padding" Value="10,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SelectedSurface}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <StackPanel Margin="{Binding ContentInsets,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Stretch">
  <TextBlock Text="全局设置" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="让每一次启动，都合乎你的习惯。" Style="{StaticResource Hint}" Margin="0,8,0,24" />
  <TextBlock x:Name="Result" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
  <StackPanel x:Name="Form" IsEnabled="False">
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="启动与监控" Style="{StaticResource Heading}" /><CheckBox Content="开机自动启动 GameHelper" IsChecked="{Binding LaunchOnSystemStartup}" /><TextBlock Text="进程监控方式（重启后台后生效）" /><ComboBox x:Name="MonitorTypes" SelectedItem="{Binding ProcessMonitorType}" HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="进程监控方式" /><TextBlock Text="ETW 需要管理员权限；WMI 可用于非管理员环境。" Style="{StaticResource Hint}" /><TextBlock Text="{Binding RestartMessage}" Style="{StaticResource Hint}" /></StackPanel></Border>
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="按显示器开启 HDR" Style="{StaticResource Heading}" /><TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource Hint}" /><ItemsControl ItemsSource="{Binding Displays}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" ToolTip="{Binding Display.DevicePath}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="只影响游戏的自动 HDR 策略，不会立即改变 Windows HDR 开关。" Style="{StaticResource Hint}" /></StackPanel></Border>
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="休息提醒" Style="{StaticResource Heading}" /><CheckBox Content="游玩期间提醒休息" IsChecked="{Binding ReminderEnabled}" /><TextBlock Text="连续游玩（分钟）" /><TextBox Text="{Binding PlayMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="连续游玩分钟" /><TextBlock Text="建议休息（分钟）" /><TextBox Text="{Binding BreakMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="建议休息分钟" /><TextBlock Text="重复提醒间隔（分钟）" /><TextBox Text="{Binding RepeatMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="重复提醒分钟" /><CheckBox Content="播放提醒声音" IsChecked="{Binding Sound}" /></StackPanel></Border>
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="显示器预设 · DDC/CI" Style="{StaticResource Heading}" /><CheckBox Content="自动切换游戏与舒适预设" IsChecked="{Binding MonitorMode.Enabled}" /><TextBlock Text="日间开始（HH:mm）" /><TextBox Text="{Binding MonitorMode.DaylightStart,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="日间开始" /><TextBlock Text="日间结束（HH:mm）" /><TextBox Text="{Binding MonitorMode.DaylightEnd,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="日间结束" /><TextBlock Text="已有位置与经纬度配置会保留；配置了位置时以日出日落为准。" Style="{StaticResource Hint}" /><Button Content="录制游戏 / 舒适预设…" Click="OnRecord" HorizontalAlignment="Left" /><TextBlock Text="先保存关闭自动切换并关闭 Windows HDR，再用显示器实体菜单切换两种模式。向导只读取，不向显示器写入。" Style="{StaticResource Hint}" /><TextBlock x:Name="Recipes" TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="Cheat Engine" Style="{StaticResource Heading}" /><TextBlock Text="程序完整路径（可留空）" /><TextBox x:Name="CePath" Text="{Binding CheatEnginePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cheat Engine 程序路径" /><Button Content="选择 Cheat Engine…" Click="OnChooseCe" HorizontalAlignment="Left" /></StackPanel></Border>
   <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="GitHub 同步" Style="{StaticResource Heading}" /><CheckBox Content="启用 GitHub 统计同步（总开关）" IsChecked="{Binding Sync.Enabled}" /><TextBlock Text="仓库（owner/name）" /><TextBox Text="{Binding Sync.Repo,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GitHub 仓库" /><TextBlock Text="上传方式" /><ComboBox x:Name="SyncMethods" SelectedItem="{Binding Sync.Method}" HorizontalAlignment="Left" MinWidth="200" AutomationProperties.Name="同步上传方式" /><TextBlock Text="分支（留空使用默认分支）" /><TextBox Text="{Binding Sync.Branch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="同步分支" /><TextBlock Text="仓库内目录" /><TextBox Text="{Binding Sync.Directory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="同步目录" /><TextBlock Text="最小间隔（分钟，至少 5）" /><TextBox Text="{Binding Sync.IntervalMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="同步间隔" /><CheckBox Content="附带原始会话 CSV" IsChecked="{Binding Sync.IncludeRawCsv}" /><TextBlock Text="API Token（仅 api 方式需要；留空使用 GAMEHELPER_GITHUB_TOKEN）" Style="{StaticResource Hint}" /><PasswordBox x:Name="Token" Background="{DynamicResource Input}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}" CaretBrush="{DynamicResource TextPrimary}" Padding="9,7" Margin="0,0,0,12" AutomationProperties.Name="GitHub API Token" /><TextBlock Text="git 方式复用本机 Git 凭据。测试连接与立即推送使用已保存配置。" Style="{StaticResource Hint}" /><WrapPanel><Button Content="刷新同步状态" Click="OnSyncStatus" Margin="0,0,10,10" /><Button Content="测试连接" Click="OnSyncValidate" Margin="0,0,10,10" /><Button Content="立即推送" Click="OnSyncPush" Margin="0,0,0,10" /></WrapPanel><TextBlock x:Name="SyncState" TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
   <WrapPanel><Button Content="保存全局设置" Click="OnSave" Background="{DynamicResource TextPrimary}" Foreground="{DynamicResource Page}" Margin="0,0,12,0" /><Button Content="放弃草稿并重新载入" Click="OnReload" /></WrapPanel>
  </StackPanel>
 </StackPanel>
</UserControl>
