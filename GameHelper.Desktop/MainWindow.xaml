<Window x:Class="GameHelper.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GameHelper.Desktop"
 Title="GameHelper · 游戏库" Width="1400" Height="900" MinWidth="1120" MinHeight="740"
 Icon="/Assets/gamehelper.ico"
 WindowStartupLocation="CenterScreen" Background="#101413" Foreground="#F0F2EB"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <ItemsPanelTemplate x:Key="CardsPanel"><WrapPanel /></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="RowsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
  <DataTemplate x:Key="CardTemplate">
   <StackPanel Width="180" Margin="10">
    <Border Height="270" CornerRadius="6" ClipToBounds="True">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#35483D" /><GradientStop Color="#1A241E" Offset="1" /></LinearGradientBrush></Border.Background>
     <Grid>
      <Image Source="{Binding Artwork}" Stretch="UniformToFill" Visibility="{Binding ArtworkIsCover, Converter={StaticResource BoolVisibility}}" />
      <Ellipse Width="190" Height="190" Stroke="#16B8E8CE" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,-50,-35,0" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <TextBlock Text="{Binding Initial}" FontSize="58" FontWeight="Light" Foreground="#B8E8CE" Margin="18" VerticalAlignment="Center" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <Image Source="{Binding Artwork}" Stretch="Uniform" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <Border Background="#E0121C16" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock Text="{Binding StateDisplay}" FontSize="11" /></Border>
     </Grid>
    </Border>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="2,12,2,6" />
    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4" />
    <TextBlock Text="{Binding Playtime}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,9" />
    <TextBlock Text="{Binding RunningSessionLine}" Foreground="#7ED99A" FontSize="11" Margin="2,0,0,9">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="RowTemplate">
   <Grid Height="82">
    <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" Background="#30483A" CornerRadius="8"><Grid><TextBlock Text="{Binding Initial}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Artwork}" Width="34" Height="34" /></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding StateDisplay}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#141A18" BorderBrush="#2B3630" BorderThickness="0,0,1,0">
   <Grid Margin="22,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><Image Source="{StaticResource BrandMark}" Width="46" Height="46" HorizontalAlignment="Left" /><TextBlock Text="GameHelper" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" /><TextBlock Text="P L A Y  /  C O L L E C T" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,38,0,0">
     <Button x:Name="LibraryNav" Content="◈   游戏库" Click="OnLibrary" Background="#2A4033" FontWeight="SemiBold" />
     <Button x:Name="StatisticsNav" Content="◷   游玩档案" Click="OnStatistics" Background="Transparent" FontWeight="SemiBold" Margin="0,8,0,0" />
     <StackPanel x:Name="LibraryTools"><Button Content="＋  添加游戏" Click="OnAdd" IsEnabled="{Binding Ready}" Margin="0,18,0,8" /><Button Content="扫描目录" Click="OnScanDirectory" IsEnabled="{Binding Ready}" Margin="0,0,0,8" /><Button Content="扫描 Steam" Click="OnSteam" IsEnabled="{Binding Ready}" /></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="3"><Button x:Name="ReloadButton" Content="重新载入" Click="OnReload" IsEnabled="{Binding Ready}" ToolTip="放弃未保存设置并重新载入" /></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="LibraryPage" Grid.Column="1" Margin="32,30,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Y O U R  P E R S O N A L  C O L L E C T I O N" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8" /><TextBlock Text="让热爱，有处珍藏。" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Count}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="搜索游戏 · Ctrl+F" Foreground="{StaticResource Muted}" FontSize="11" /><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索游戏" /></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,22,0,15">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="GridLayout" Background="{StaticResource SelectedSurface}" Content="网格" Tag="grid" Click="OnLayout" Margin="0,0,8,0" /><Button x:Name="ListLayout" Content="列表" Tag="list" Click="OnLayout" /></StackPanel>
     <StackPanel Orientation="Horizontal"><Button x:Name="InstalledGroup" Content="本机已安装" Tag="installed" Click="OnInstallationGroup" Background="#355744" Margin="0,0,8,0" /><Button x:Name="MissingGroup" Content="本地未找到" Tag="missing" Click="OnInstallationGroup" Margin="0,0,8,0" /><Button x:Name="UnknownGroup" Content="待确认" Tag="unknown" Click="OnInstallationGroup" Margin="0,0,8,0" /><Button x:Name="AllGroup" Content="全部" Tag="all" Click="OnInstallationGroup" /></StackPanel>
    </DockPanel>
    <DockPanel Margin="0,10,0,0">
     <Button DockPanel.Dock="Right" Content="按名称补全海报" Click="OnMatchMissingPosters" IsEnabled="{Binding Ready}" />
     <StackPanel Orientation="Horizontal"><Button x:Name="AllType" Background="{StaticResource SelectedSurface}" Content="所有类型" Tag="all" Click="OnFilter" Margin="0,0,8,0" /><Button x:Name="HdrType" Content="HDR" Tag="hdr" Click="OnFilter" Margin="0,0,8,0" /><Button x:Name="SpeedType" Content="倍速" Tag="speed" Click="OnFilter" /><TextBlock Text="{Binding InstallationSummary}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" /></StackPanel>
    </DockPanel>
   </StackPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
    <ListBox x:Name="GameList" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="White" BorderThickness="0" ClipToBounds="True"
     ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource CardsPanel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" />
    <StackPanel Margin="22,40" IsHitTestVisible="False">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Games.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="还没有找到游戏" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
     <TextBlock Text="试试其他名称或分组，也可以扫描目录、添加程序。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="22" />
    </StackPanel>
    <Border Grid.Column="1" Background="#19211E" BorderBrush="#2B3630" BorderThickness="1" CornerRadius="8" Margin="18,0,0,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="28">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Image Source="{StaticResource BrandMark}" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,20" />
      <TextBlock Text="下一段旅程，由你选择。" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,12" />
      <TextBlock Text="选择一款游戏，查看记录与启动设置。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" />
     </StackPanel>
     <ScrollViewer x:Name="GameDetailsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20">
      <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <StackPanel>
       <TextBlock Text="S E L E C T E D  /  G A M E" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
       <Border Height="126" CornerRadius="6" Background="#25352B" ClipToBounds="True" Margin="0,0,0,18">
        <Grid><TextBlock Text="{Binding Selected.Initial}" FontSize="56" FontWeight="Light" Foreground="#B8E8CE" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Selected.Artwork}" Stretch="UniformToFill" Visibility="{Binding Selected.ArtworkIsCover, Converter={StaticResource BoolVisibility}}" /><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0019211E" /><GradientStop Color="#C019211E" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
       </Border>
       <TextBlock Text="{Binding Selected.Name, TargetNullValue=请选择游戏, FallbackValue=请选择游戏}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Selected.StateDisplay}" Foreground="#B8E8CE" Margin="0,10,0,4" /><TextBlock Text="{Binding Selected.Playtime}" Foreground="{StaticResource Muted}" FontSize="12" />
       <TextBlock Text="{Binding Selected.InstallationLabel}" ToolTip="{Binding Selected.InstallationDetail}" Foreground="#B7C4BB" FontSize="12" Margin="0,8,0,0" />
       <TextBlock Text="{Binding Selected.PosterStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
       <Button Content="匹配 / 重试 Steam 海报…" Click="OnPoster" IsEnabled="{Binding Ready}" Margin="0,10,0,0" />
       <StackPanel DataContext="{Binding Selected}" IsEnabled="{Binding DataContext.Ready, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Text="游戏名称" Foreground="{StaticResource Muted}" FontSize="12" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏名称" />
        <CheckBox Content="启用游戏自动化" IsChecked="{Binding Enabled}" />
        <CheckBox Content="启动前开启 HDR" IsChecked="{Binding Hdr}" />
        <StackPanel Orientation="Horizontal"><CheckBox Content="游戏倍速" IsChecked="{Binding UseSpeed}" /><TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="12,0,0,0" IsEnabled="{Binding UseSpeed}" AutomationProperties.Name="倍速倍率" /></StackPanel>
        <TextBlock Text="启动入口" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" />
        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" ToolTip="游戏 exe、快捷方式完整路径，或 steam://rungameid/数字" AutomationProperties.Name="启动入口" />
        <Button Content="选择程序或快捷方式…" Click="OnChooseEntry" />
        <CheckBox IsChecked="{Binding UseDs4Windows}"><TextBlock Text="启动前运行 DS4Windows（PS 手柄）" TextWrapping="Wrap" /></CheckBox>
        <StackPanel Visibility="{Binding UseDs4Windows, Converter={StaticResource BoolVisibility}}">
         <TextBox Text="{Binding Ds4WindowsPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="DS4Windows 程序路径" />
         <Button Content="选择 DS4Windows 程序…" Click="OnChooseDs4Windows" />
         <TextBlock Text="先启动手柄兼容程序，再启动游戏；仅从游戏库启动时生效，退出游戏后保持运行。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Expander Header="启动参数与进程匹配" Foreground="#C5CEC7" Margin="0,8,0,16">
         <StackPanel Margin="0,10,0,0">
          <TextBlock Text="启动参数" FontSize="12" /><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="工作目录（可留空）" FontSize="12" /><TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="用于识别游戏的程序" FontSize="12" /><TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
         </StackPanel>
        </Expander>
       </StackPanel>
       <TextBlock Text="HDR 生效后才启动；游戏退出后恢复本工具修改的状态。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,16" />
       <Button Content="从目录移除" Click="OnRemove" Background="#45303B" IsEnabled="{Binding Ready}" />
      </StackPanel>
     </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="20,10,20,18">
       <Button Content="启动游戏  →" Command="{Binding LaunchCommand}" Background="#B8E8CE" Foreground="#122219" FontWeight="SemiBold" BorderBrush="#B8E8CE" Margin="0,0,0,10" ToolTip="填写启动入口后可启动；未保存的设置会先保存" />

       <Button Content="保存设置" Command="{Binding SaveCommand}" FontWeight="SemiBold" />
       <TextBlock Text="有未保存的修改；启动时会先保存。" FontSize="11" Foreground="#F0C783" TextWrapping="Wrap" Margin="0,10,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Selected.IsDirty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding ConfigPath}" />
    <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}" Margin="14,0,0,0" />
   </Grid>
  </Grid>
  <local:StatisticsView x:Name="StatisticsPage" Grid.Column="1" Visibility="Collapsed" />
 </Grid>
</Window>
