<Window x:Class="GameHelper.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameHelper.Desktop"
 Title="GameHelper · 游戏库" Width="1400" Height="900" MinWidth="1120" MinHeight="740" Icon="/Assets/gamehelper.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource Page}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="11" /></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,12" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
  <Style x:Key="NavigationGlyph" TargetType="Path"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" /><Setter Property="StrokeThickness" Value="1.7" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
  <Style x:Key="Toggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="30" Height="17" CornerRadius="9" Background="#CCCCCC"><Ellipse x:Name="Knob" Fill="White" Width="13" Height="13" Margin="2" HorizontalAlignment="Left" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#8D78B7" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="Track" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RunningHalo" TargetType="Border">
   <Setter Property="BorderBrush"><Setter.Value>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <LinearGradientBrush.RelativeTransform><RotateTransform CenterX="0.5" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
     <GradientStop Color="#3073DDB3" Offset="0" /><GradientStop Color="#FF73DDB3" Offset="0.35" />
     <GradientStop Color="#FFE2FFF6" Offset="0.5" /><GradientStop Color="#FF65CBE8" Offset="0.65" /><GradientStop Color="#3073DDB3" Offset="1" />
    </LinearGradientBrush>
   </Setter.Value></Setter>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#73DDB3" ShadowDepth="0" BlurRadius="9" Opacity="0.25" /></Setter.Value></Setter>
   <Setter Property="BorderThickness" Value="3" /><Setter Property="CornerRadius" Value="9" />
   <Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Visibility" Value="Collapsed" />
   <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True">
    <Setter Property="Visibility" Value="Visible" />
    <DataTrigger.EnterActions>
     <BeginStoryboard x:Name="RunningFlow"><Storyboard>
      <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0.25" To="0.8" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
       <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
     </Storyboard></BeginStoryboard>
    </DataTrigger.EnterActions>
    <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="RunningFlow" /></DataTrigger.ExitActions>
   </DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="CardTemplate"><StackPanel Margin="0,0,16,19">
   <Grid Height="{Binding CardPosterHeight,RelativeSource={RelativeSource AncestorType=Window}}" x:Name="PosterFrame"><local:GamePosterTile Artwork="{Binding CoverArtwork}" Label="{Binding Initial}" Radius="9" /><Border Style="{StaticResource RunningHalo}" Margin="5" CornerRadius="4" /><Border Background="#B8171A21" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"><TextBlock Text="{Binding CardBadge}" FontSize="9" Foreground="White" /></Border></Grid>
   <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Margin="0,12,0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding CardSummary}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding RunningSessionLine}" FontSize="10" Foreground="{DynamicResource Success}" Visibility="{Binding IsRunning,Converter={StaticResource BoolVisibility}}" />
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="RowTemplate"><Grid Height="80" Margin="0,0,16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><Grid Width="44" Height="66" HorizontalAlignment="Left"><local:GamePosterTile Artwork="{Binding Artwork}" Label="{Binding Initial}" Radius="7" /><Border Style="{StaticResource RunningHalo}" Margin="2" CornerRadius="5" BorderThickness="2" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" /><TextBlock Text="{Binding CardSummary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding StateDisplay}" FontSize="11" VerticalAlignment="Center" /></Grid></DataTemplate>
  <ItemsPanelTemplate x:Key="CardsPanel"><UniformGrid Columns="{Binding CardColumns,RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate><ItemsPanelTemplate x:Key="RowsPanel"><StackPanel /></ItemsPanelTemplate>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><ContentPresenter />
   <Grid x:Name="SelectionFrame" Margin="0,0,16,0" Height="{Binding CardPosterHeight,RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="9" Opacity="0.32" />
    <Border x:Name="Ring" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="7.5" Margin="1.5" />
    <Border BorderBrush="{DynamicResource Page}" BorderThickness="1" CornerRadius="5.5" Margin="3.5" Opacity="0.8" />
   </Grid>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFrame" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusStrong}" /></Trigger><DataTrigger Binding="{Binding ItemTemplate,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{StaticResource RowTemplate}"><Setter TargetName="SelectionFrame" Property="Height" Value="80" /></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
 <Grid Background="{DynamicResource Page}"><ScrollViewer x:Name="WorkspaceScroll" ScrollChanged="OnWorkspaceScrollChanged" SizeChanged="OnStickyViewportChanged" local:PageWheelScroll.Enabled="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}" /><ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="15" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" /></Grid></ControlTemplate></ScrollViewer.Template><Grid MinHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Window}}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth,RelativeSource={RelativeSource AncestorType=Window}}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0"><Grid Margin="{Binding SidebarInsets,RelativeSource={RelativeSource AncestorType=Window}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Viewbox Width="34" Height="34" Margin="0,0,10,0"><Canvas Width="64" Height="64"><Path Data="{StaticResource BrandGlyph}" Fill="{DynamicResource TextPrimary}" /><Path Data="{StaticResource BrandPlay}" Fill="#AC94D7" /></Canvas></Viewbox><StackPanel><TextBlock Text="GameHelper" FontSize="{Binding BrandFontSize,RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" /><local:TrackingText Text="YOUR PLAY, IN" FontSize="10" Tracking="2" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" /><local:TrackingText Text="PLACE." FontSize="10" Tracking="2" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" /></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,32,0,0"><Button x:Name="LibraryNav" Click="OnLibrary" Style="{StaticResource NavButton}" Background="{DynamicResource NavigationSelected}"><Grid ><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Path Style="{StaticResource NavigationGlyph}" Data="M3,4 Q3,3 4,3 H8 V21 H4 Q3,21 3,20 Z M8,3 H13 V21 H8 M16,4 L20,3 L24,20 L20,21 Z" /><TextBlock Grid.Column="1" Text="游戏库" /><TextBlock Grid.Column="2" Text="{Binding CatalogCount}" FontSize="11" Foreground="{DynamicResource Muted}" /></Grid></Button>
  <Button x:Name="GlobalSettingsNav" Click="OnGlobalSettings" Style="{StaticResource NavButton}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M4,5 H22 M4,12 H22 M4,19 H22 M9,2 V8 M17,9 V15 M11,16 V22" Margin="0,0,10,0" /><TextBlock Text="全局设置" /></StackPanel></Button>
  <Button x:Name="StatisticsNav" Click="OnStatistics" Style="{StaticResource NavButton}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M3,3 V21 H22 M8,16 V12 M14,16 V7 M20,16 V3" Margin="0,0,10,0" /><TextBlock Text="游玩档案" /></StackPanel></Button>
  <Button Click="OnManage" Style="{StaticResource NavButton}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M3,6 H7 M13,6 H21 M3,12 H13 M19,12 H21 M3,18 H5 M11,18 H21 M13,6 A3,3 0 1 1 7,6 A3,3 0 1 1 13,6 M19,12 A3,3 0 1 1 13,12 A3,3 0 1 1 19,12 M11,18 A3,3 0 1 1 5,18 A3,3 0 1 1 11,18" Margin="0,0,10,0" /><TextBlock Text="游戏管理" /></StackPanel></Button></StackPanel>
  <StackPanel Grid.Row="2" Margin="0,32,0,0"><TextBlock Text="游戏类型" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,0,0,12" /><ItemsControl ItemsSource="{Binding GenreGroups}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="OnGenre" Tag="{Binding Name}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="14,10"><Grid ><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="#AAAAAA" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Muted}" /><TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource Muted}" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
  <StackPanel Grid.Row="4" Margin="0,32,0,0"><Border Background="{DynamicResource Page}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="● 静静记录每次冒险" FontSize="12" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border><Button x:Name="ThemeButton" Content="浅色主题" Click="OnTheme" Style="{StaticResource QuietButton}" Margin="0,12,0,0" /><Button x:Name="ReloadButton" Content="重新载入" Click="OnReload" Style="{StaticResource QuietButton}" IsEnabled="{Binding Ready}" /></StackPanel>
 </Grid></Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="36,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M3,10 L12,3 L21,10 V21 H15 V15 H9 V21 H3 Z" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0" /><TextBlock Text="/    我的空间    /    GameHelper" FontSize="12" Foreground="{DynamicResource Muted}" /></StackPanel><Button Content="刷新" Click="OnRefreshLibrary" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
  <Grid x:Name="LibraryPage" Grid.Row="1" Margin="{Binding ContentInsets,RelativeSource={RelativeSource AncestorType=Window}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="每一段冒险，都值得珍藏。" FontSize="30" FontWeight="SemiBold" LineHeight="45" LineStackingStrategy="BlockLineHeight"><TextBlock.RenderTransform><ScaleTransform ScaleX="0.96" /></TextBlock.RenderTransform></TextBlock><TextBlock Text="你的游戏，你的节奏。下一次出发，从这里开始。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" LineHeight="18" LineStackingStrategy="BlockLineHeight" /></StackPanel><Button Grid.Column="1" Content="＋  添加游戏" Click="OnAddMenu" IsEnabled="{Binding Ready}" VerticalAlignment="Center" FontSize="12" /></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding SplitGap,RelativeSource={RelativeSource AncestorType=Window}}" /><ColumnDefinition Width="{Binding DetailWidth,RelativeSource={RelativeSource AncestorType=Window}}" /></Grid.ColumnDefinitions>
   <StackPanel><Border x:Name="HeroPanel" CornerRadius="14" Height="{Binding HeroHeight,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,27" Background="#24252B" ClipToBounds="True" Visibility="{Binding HasContinueGame,Converter={StaticResource BoolVisibility}}"><Grid><local:GamePosterTile Artwork="{Binding ContinueGame.BannerArtwork}" Label="{Binding ContinueGame.Initial}" Radius="14" CropY="0.42" /><Border CornerRadius="14"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EF171B20" /><GradientStop Color="#70171B20" Offset="0.65" /><GradientStop Color="#15171B20" Offset="1" /></LinearGradientBrush></Border.Background></Border><StackPanel Margin="29" VerticalAlignment="Bottom"><local:TrackingText Height="15" Text="JUMP BACK IN / 继续你的旅程" Foreground="#D2D7D1" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding ContinueGame.Name}" FontFamily="Georgia, Microsoft YaHei UI" FontSize="35" LineHeight="52.5" LineStackingStrategy="BlockLineHeight" FontWeight="Normal" Foreground="White" Margin="0,10,0,6" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ContinueGame.LastPlayedLabel}" Foreground="#D7DBD5" FontSize="12" Height="18" /><StackPanel Orientation="Horizontal" Margin="0,19,0,0" Height="40"><Button Content="▷ 继续游戏" Height="38" VerticalAlignment="Center" Click="OnContinue" Background="White" Foreground="#252625" BorderBrush="Transparent" FontSize="12" Padding="18,10" /><Button Content="查看详情 ↗" Height="40" Padding="18,10" Click="OnContinueDetails" Background="#15FFFFFF" Foreground="White" BorderBrush="#40FFFFFF" FontSize="12" Margin="5,0,0,0" /></StackPanel></StackPanel></Grid></Border>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding CollectionTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="GridLayout" Tag="grid" Click="OnToggleLayout" Padding="12,9"><Path Data="M1,1 H7 V7 H1 Z M12,1 H18 V7 H12 Z M1,12 H7 V18 H1 Z M12,12 H18 V18 H12 Z" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.3" Width="18" Height="18" /></Button><Button x:Name="ListLayout" Visibility="Collapsed" Content="☷" Tag="list" Click="OnLayout" Padding="12,9" Margin="5,0,0,0" /></StackPanel></Grid>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Margin="0,0,10,0" Height="38"><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="0" Margin="0" AutomationProperties.Name="搜索游戏"><TextBox.Template><ControlTemplate TargetType="TextBox"><Border CornerRadius="8" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Background="{DynamicResource Page}" Padding="38,0,10,0"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></Border></ControlTemplate></TextBox.Template></TextBox><Path Data="M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 M12,12 L18,18" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" /><TextBlock Text="搜索你的下一段冒险…" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AllGroup" Content="全部" Tag="all" Click="OnInstallationGroup" Style="{StaticResource QuietButton}" /><Button x:Name="InstalledGroup" Content="已安装" Tag="installed" Click="OnInstallationGroup" Style="{StaticResource QuietButton}" /><Button x:Name="HdrType" Content="HDR" Tag="hdr" Click="OnFilter" Style="{StaticResource QuietButton}" /><Button Content="···" Click="OnFiltersMenu" Style="{StaticResource QuietButton}" /></StackPanel></Grid>
   <ListBox x:Name="GameList" SizeChanged="OnGameListSizeChanged" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource CardsPanel}" Background="Transparent" BorderThickness="0" Margin="0,0,-16,0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
   <StackPanel Margin="20,35" Visibility="{Binding Games.IsEmpty,Converter={StaticResource BoolVisibility}}"><TextBlock Text="还没有找到游戏" FontSize="22" /><TextBlock Text="试试其他名称或类型，也可以添加游戏。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0" /></StackPanel>
   </StackPanel>
   <Grid x:Name="DetailHost" Grid.Column="2" SizeChanged="OnStickyViewportChanged"><ScrollViewer x:Name="StickyDetails" local:PageWheelScroll.Independent="True" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.RenderTransform><TranslateTransform x:Name="DetailOffset" /></ScrollViewer.RenderTransform><StackPanel><Border x:Name="DetailCard" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="13"><Grid><Grid.RowDefinitions><RowDefinition Height="118" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><local:GamePosterTile Artwork="{Binding Selected.DetailArtwork}" Label="{Binding Selected.Initial}" Radius="12" RoundBottom="False" /><StackPanel Grid.Row="1" Margin="21"><local:TrackingText Height="13.5" Text="IN YOUR COLLECTION" FontSize="9" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding Selected.Name,TargetNullValue=选择一款游戏}" FontSize="20" FontWeight="SemiBold" LineHeight="30" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,10,0,3" /><TextBlock Text="{Binding Selected.GenreLabel}" FontSize="12" Height="18" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Selected.InstallationLabel}" FontSize="10" Height="15" Foreground="{DynamicResource Success}" Margin="0,9,0,0" /><Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,20"><UniformGrid Columns="2"><StackPanel><TextBlock Text="总游玩时长" FontSize="10" Height="15" Foreground="{DynamicResource Muted}" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="28.5"><TextBlock Text="{Binding Selected.HoursValue}" FontSize="19" /><TextBlock Text="小时" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,3" VerticalAlignment="Bottom" /></StackPanel></StackPanel><StackPanel><TextBlock Text="上次游玩" FontSize="10" Height="15" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding Selected.LastPlayedShort}" FontSize="17" Height="28.5" Margin="0,5,0,0" /></StackPanel></UniformGrid></Border>
   <StackPanel DataContext="{Binding Selected}" IsEnabled="{Binding DataContext.Ready,RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20,0,0"><local:TrackingText Height="13.5" Text="LAUNCH PREFERENCES" FontSize="9" Foreground="{DynamicResource Muted}" /><Grid Margin="0,17,0,0"><StackPanel><TextBlock Text="自动开启 HDR" FontSize="11" Height="16.5" /><TextBlock Text="启动时切换，退出后恢复" FontSize="9" Height="13.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" /></StackPanel><CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Hdr}" HorizontalAlignment="Right" AutomationProperties.Name="自动开启 HDR" /></Grid><Grid Margin="0,17,0,0"><StackPanel><TextBlock Text="手柄支持" FontSize="11" Height="16.5" /><TextBlock Text="启动时按开关运行或退出" FontSize="9" Height="13.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" /></StackPanel><CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding UseDs4Windows}" ToolTip="启动该游戏时：开启则运行 DS4Windows；关闭则退出当前会话中的 DS4Windows。" HorizontalAlignment="Right" AutomationProperties.Name="手柄支持" /></Grid><Grid Margin="0,17,0,0"><StackPanel><TextBlock Text="游戏倍速" FontSize="11" Height="16.5" /><TextBlock Text="{Binding Speed, StringFormat={}{0} × · 游戏速度}" FontSize="9" Height="13.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" /></StackPanel><CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding UseSpeed}" HorizontalAlignment="Right" AutomationProperties.Name="游戏倍速" /></Grid></StackPanel>
   <Border Background="{DynamicResource Page}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,16,0,0" Visibility="{Binding HasActionError,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding ActionError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Warning}" /><Button Content="放弃此游戏草稿并重载" Command="{Binding ReloadSelectedCommand}" ToolTip="放弃此游戏的未保存草稿，读取已保存设置；其他游戏的草稿保留。" FontSize="10" Padding="6,7" Margin="0,8,0,0" /></StackPanel></Border>
   <Button Content="▷ 启动游戏" Height="38" Command="{Binding LaunchCommand}" Background="{DynamicResource TextPrimary}" Foreground="{DynamicResource Page}" BorderBrush="{DynamicResource TextPrimary}" FontSize="12" Margin="0,27,0,0" /><Button Content="设置与管理… · 启动前保存" Click="OnSettings" Style="{StaticResource QuietButton}" FontSize="9" Padding="0" BorderThickness="0" Height="13.5" Margin="0,10,0,0" /><TextBlock Text="{Binding Selected.RunningSessionLine}" Visibility="{Binding Selected.IsRunning,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Success}" FontSize="10" TextAlignment="Center" /></StackPanel></Grid></Border>
   <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><local:TrackingText Text="THIS WEEK" FontSize="10" Foreground="{DynamicResource Muted}" /><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="{Binding WeeklyHours}" FontSize="24" /><TextBlock Text="小时" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,4" /></StackPanel><local:PlaytimeMiniTrend Grid.Column="1" Points="{Binding WeeklyTrend}" Height="39" /></Grid><TextBlock Text="把时间花在喜欢的世界里。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" /></StackPanel></Border></StackPanel></ScrollViewer></Grid>
  </Grid></Grid>
  <local:GlobalSettingsView x:Name="GlobalSettingsPage" Grid.Row="1" Visibility="Collapsed" />
  <local:StatisticsView x:Name="StatisticsPage" Grid.Row="1" Visibility="Collapsed" />
 </Grid></Grid></ScrollViewer>
 <Border x:Name="SettingsPanel" Background="#60000000" Visibility="Collapsed"><Border Background="{DynamicResource Page}" CornerRadius="14" Width="500" MaxHeight="680" Margin="24" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel><Button Content="关闭 ✕" DockPanel.Dock="Right" Click="OnCloseSettings" Style="{StaticResource QuietButton}" /><TextBlock Text="游戏设置与管理" FontSize="20" FontWeight="SemiBold" /></DockPanel><ScrollViewer x:Name="GameDetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18"><StackPanel>       <TextBlock Text="{Binding Selected.PosterStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
       <TextBlock Text="{Binding Selected.GenreLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" /><Button Content="编辑游戏类型…" Click="OnEditGenres" IsEnabled="{Binding Ready}" Margin="0,8,0,0" />
       <Button Content="匹配 / 重试 Steam 海报…" Click="OnPoster" IsEnabled="{Binding Ready}" Margin="0,10,0,0" />
       <StackPanel DataContext="{Binding Selected}" IsEnabled="{Binding DataContext.Ready, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Text="游戏名称" Foreground="{DynamicResource Muted}" FontSize="12" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏名称" />
        <CheckBox Content="启用游戏自动化" IsChecked="{Binding Enabled}" />
        <CheckBox Content="启动前开启 HDR" IsChecked="{Binding Hdr}" />
        <StackPanel Orientation="Horizontal"><CheckBox Content="游戏倍速" IsChecked="{Binding UseSpeed}" /><TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="12,0,0,0" IsEnabled="{Binding UseSpeed}" AutomationProperties.Name="倍速倍率" /></StackPanel>
        <TextBlock Text="游戏内倍速热键（每行一项）" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0" />
        <TextBox Text="{Binding SpeedHotkeys, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="76" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding UseSpeed}" AutomationProperties.Name="游戏内倍速热键" />
        <TextBlock Text="Ctrl+F1=2 设置 2×；Ctrl+F2=1 恢复原速；Ctrl+F3=toggle 在主倍速与原速间切换。支持 Ctrl/Alt/Shift、F1–F12、A–Z、0–9；倍率用小数点。留空则使用全局设置里的默认热键。保存后下次启动生效。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="启动入口" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,0" />
        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" ToolTip="游戏 exe、快捷方式完整路径，或 steam://rungameid/数字" AutomationProperties.Name="启动入口" />
        <Button Content="选择程序或快捷方式…" Click="OnChooseEntry" />
        <TextBlock Text="启动前 / 退出后动作" FontWeight="SemiBold" Margin="0,18,0,8" />
        <CheckBox IsChecked="{Binding UseDs4Windows}"><TextBlock Text="预设：DS4Windows（PS 手柄）；未勾选时启动游戏会关闭它" TextWrapping="Wrap" /></CheckBox>
        <StackPanel Visibility="{Binding UseDs4Windows, Converter={StaticResource BoolVisibility}}">
         <TextBox Text="{Binding Ds4WindowsPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="DS4Windows 程序路径" />
         <Button Content="选择 DS4Windows 程序…" Click="OnChooseDs4Windows" />
         <TextBlock Text="先启动手柄兼容程序，再启动游戏；外部启动与恢复也应用此设置，退出游戏后保持运行。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="通用动作按各自时机的列表顺序执行。启动前失败中止游戏启动；退出后失败仅记录警告。" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,4" />
        <ItemsControl ItemsSource="{Binding ActionEditor.Items}">
         <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
          <StackPanel>
           <StackPanel Orientation="Horizontal">
            <ComboBox SelectedValue="{Binding When, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="136" AutomationProperties.Name="动作时机"><ComboBoxItem Content="启动前" Tag="beforeLaunch" /><ComboBoxItem Content="退出后" Tag="afterExit" /></ComboBox>
            <ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="136" Margin="8,0,0,0" AutomationProperties.Name="动作类型"><ComboBoxItem Content="运行程序" Tag="run" /><ComboBoxItem Content="关闭程序" Tag="close" /></ComboBox>
           </StackPanel>
           <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="动作 exe 完整路径" ToolTip="exe 完整路径" />
           <Button Content="选择动作程序…" Click="OnChooseAction" />
           <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRun}" AutomationProperties.Name="动作参数" ToolTip="可选启动参数" />
           <CheckBox Content="等待退出（最多 30 秒）" IsChecked="{Binding Wait}" IsEnabled="{Binding IsRun}" />
           <StackPanel Orientation="Horizontal"><Button Content="上移" Click="OnMoveActionUp" /><Button Content="下移" Click="OnMoveActionDown" Margin="8,0" /><Button Content="删除" Click="OnRemoveAction" /></StackPanel>
          </StackPanel>
         </Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="添加通用动作" Click="OnAddAction" Margin="0,8" />
        <Expander Header="启动参数与进程匹配" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,16">
         <StackPanel Margin="0,10,0,0">
          <TextBlock Text="启动参数" FontSize="12" /><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="工作目录（可留空）" FontSize="12" /><TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="用于识别游戏的程序" FontSize="12" /><TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
         </StackPanel>
        </Expander>
       </StackPanel>
       <TextBlock Text="HDR 生效后才启动；游戏退出后恢复本工具修改的状态。" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,16" />
       <Button Content="从目录移除" Click="OnRemove" Background="{DynamicResource Danger}" IsEnabled="{Binding Ready}" /></StackPanel></ScrollViewer><Button Grid.Row="2" Content="保存设置" Command="{Binding SaveCommand}" /></Grid></Border></Border>
 <StackPanel x:Name="LibraryTools" Visibility="Collapsed"><Button x:Name="MissingGroup" Tag="missing" /><Button x:Name="UnknownGroup" Tag="unknown" /><Button x:Name="AllType" Tag="all" /><Button x:Name="SpeedType" Tag="speed" /></StackPanel>
 </Grid></Window>