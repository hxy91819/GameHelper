<Window x:Class="GameHelper.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GameHelper · 游戏库" Width="1400" Height="900" MinWidth="1120" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="#10151F" Foreground="#EEF3FB"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <ItemsPanelTemplate x:Key="CardsPanel"><WrapPanel /></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="RowsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
  <DataTemplate x:Key="CardTemplate">
   <StackPanel Width="206" Margin="6">
    <Border Height="309" CornerRadius="9" ClipToBounds="True">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#355A83" /><GradientStop Color="#1B2333" Offset="1" /></LinearGradientBrush></Border.Background>
     <Grid>
      <Image Source="{Binding Artwork}" Stretch="UniformToFill" Visibility="{Binding ArtworkIsCover, Converter={StaticResource BoolVisibility}}" />
      <Ellipse Width="160" Height="160" Stroke="#1EFFFFFF" StrokeThickness="24" HorizontalAlignment="Right" Margin="0,-50,-35,0" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <TextBlock Text="{Binding Initial}" FontSize="48" Margin="18" VerticalAlignment="Center" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <Image Source="{Binding Artwork}" Stretch="Uniform" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" Visibility="{Binding ArtworkIsIcon, Converter={StaticResource BoolVisibility}}" />
      <Border Background="#C015233A" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock Text="{Binding State}" FontSize="11" /></Border>
     </Grid>
    </Border>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="2,12,2,6" />
    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4" />
    <TextBlock Text="{Binding Playtime}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,9" />
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="RowTemplate">
   <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="76">
    <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" Background="#314C71" CornerRadius="8"><Grid><TextBlock Text="{Binding Initial}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Artwork}" Width="34" Height="34" /></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#171E2B" BorderBrush="#2A354A" BorderThickness="0,0,1,0">
   <Grid Margin="18,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="GH /" Foreground="#92B0FF" FontSize="32" FontWeight="Bold" /><TextBlock Text="GameHelper" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="LOCAL GAME LIBRARY" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,38,0,0">
     <Border Background="#2B3E60" CornerRadius="8" Padding="14,12"><TextBlock Text="▦  游戏库" FontWeight="SemiBold" /></Border>
     <Button Content="＋  添加游戏" Click="OnAdd" IsEnabled="{Binding Ready}" Margin="0,18,0,8" />
     <Button Content="扫描 Steam" Click="OnSteam" IsEnabled="{Binding Ready}" />
    </StackPanel>
    <StackPanel Grid.Row="3"><Button Content="重新载入" Click="OnReload" IsEnabled="{Binding Ready}" ToolTip="放弃未保存设置并重新载入" /><TextBlock Text="本地配置 · Windows" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" /></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,24,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="游戏库" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{Binding Count}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="搜索游戏 · Ctrl+F" Foreground="{StaticResource Muted}" FontSize="11" /><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索游戏名称或程序（Ctrl+F）" AutomationProperties.Name="搜索游戏" /></StackPanel>
   </Grid>
   <DockPanel Grid.Row="1" Margin="0,22,0,15">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="网格" Tag="grid" Click="OnLayout" Margin="0,0,8,0" /><Button Content="列表" Tag="list" Click="OnLayout" /></StackPanel>
    <StackPanel Orientation="Horizontal"><Button Content="全部" Tag="all" Click="OnFilter" Margin="0,0,8,0" /><Button Content="HDR" Tag="hdr" Click="OnFilter" Margin="0,0,8,0" /><Button Content="倍速" Tag="speed" Click="OnFilter" /></StackPanel>
   </DockPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="350" /></Grid.ColumnDefinitions>
    <ListBox x:Name="GameList" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="White" BorderThickness="0" ClipToBounds="True"
     ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource CardsPanel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" />
    <TextBlock Text="没有匹配的游戏。可添加程序，或扫描 Steam 游戏库。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="22,40" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Games.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Border Grid.Column="1" Background="#1A2230" CornerRadius="12" Margin="18,0,0,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20">
      <StackPanel>
       <TextBlock Text="{Binding Selected.Name, TargetNullValue=请选择游戏, FallbackValue=请选择游戏}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Selected.State}" Foreground="#A9C6FF" Margin="0,10,0,4" /><TextBlock Text="{Binding Selected.Playtime}" Foreground="{StaticResource Muted}" FontSize="12" />
       <TextBlock Text="{Binding Selected.PosterStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
       <Button Content="匹配 / 重试 Steam 海报…" Click="OnPoster" IsEnabled="{Binding Ready}" Margin="0,10,0,0" />
       <Button Content="启动游戏  →" Command="{Binding LaunchCommand}" Background="#6389E7" Margin="0,20,0,12" ToolTip="填写启动入口后可启动；未保存的设置会先保存" />
       <StackPanel DataContext="{Binding Selected}" IsEnabled="{Binding DataContext.Ready, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Text="游戏名称" Foreground="{StaticResource Muted}" FontSize="12" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏名称" />
        <CheckBox Content="启用游戏自动化" IsChecked="{Binding Enabled}" />
        <CheckBox Content="启动前开启 HDR" IsChecked="{Binding Hdr}" />
        <StackPanel Orientation="Horizontal"><CheckBox Content="游戏倍速" IsChecked="{Binding UseSpeed}" /><TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="12,0,0,0" IsEnabled="{Binding UseSpeed}" AutomationProperties.Name="倍速倍率" /></StackPanel>
        <TextBlock Text="启动入口" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" />
        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" ToolTip="游戏 exe、快捷方式完整路径，或 steam://rungameid/数字" AutomationProperties.Name="启动入口" />
        <Button Content="选择程序或快捷方式…" Click="OnChooseEntry" />
        <Expander Header="启动参数与进程匹配" Foreground="#C2CEE2" Margin="0,8,0,16">
         <StackPanel Margin="0,10,0,0">
          <TextBlock Text="启动参数" FontSize="12" /><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="工作目录（可留空）" FontSize="12" /><TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="用于识别游戏的程序" FontSize="12" /><TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
         </StackPanel>
        </Expander>
       </StackPanel>
       <TextBlock Text="HDR 生效后才启动；游戏退出后恢复本工具修改的状态。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,16" />
       <Button Content="从目录移除" Click="OnRemove" Background="#45303B" IsEnabled="{Binding Ready}" />
      </StackPanel>
     </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="20,10,20,18">
       <Button Content="保存设置" Command="{Binding SaveCommand}" />
       <TextBlock Text="有未保存的修改；启动时会先保存。" FontSize="11" Foreground="#F0C783" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Selected.IsDirty, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding ConfigPath}" />
    <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshCommand}" Margin="14,0,0,0" />
   </Grid>
  </Grid>
 </Grid>
</Window>
