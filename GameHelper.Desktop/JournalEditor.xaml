<Window x:Class="GameHelper.Desktop.JournalEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="私人手帐" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource Page}" Foreground="{DynamicResource TextPrimary}">
 <StackPanel Margin="24">
  <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
  <TextBlock Text="归档状态（可多选）" Margin="0,20,0,4" Foreground="{DynamicResource Muted}" />
  <ItemsControl ItemsSource="{Binding StatusOptions}" AutomationProperties.Name="归档状态">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnStatusClick" Margin="0,4,12,4" />
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="通关日期（可留空）" Margin="0,12,0,6" Foreground="{DynamicResource Muted}" />
  <DatePicker SelectedDate="{Binding CompletedOn}" IsEnabled="{Binding IsCompleted}" AutomationProperties.Name="通关日期" />
  <TextBlock Text="私人短评" Margin="0,16,0,6" Foreground="{DynamicResource Muted}" />
  <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding NoteLimit}" AcceptsReturn="False" TextWrapping="Wrap"
           VerticalContentAlignment="Top" Height="112" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="私人短评" />
  <TextBlock Text="{Binding NoteCount}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,6,0,0" />
  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" IsCancel="True" Margin="0,0,8,0" /><Button Content="保存手帐" Click="OnSave" IsDefault="True" />
  </StackPanel>
 </StackPanel>
</Window>
